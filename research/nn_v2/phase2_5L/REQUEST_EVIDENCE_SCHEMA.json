          "type": "object",
          "properties": {
            "schema_version": {
              "const": "NNV2_UA_PREPARED_V1"
            },
            "method": {
              "const": "GET"
            },
            "target_url": {
              "type": "string"
            },
            "URL": {
              "type": "object",
              "properties": {
                "literal": {
                  "type": "string"
                },
                "scheme": {
                  "const": "https"
                },
                "host": {
                  "const": "synthetic.invalid"
                },
                "port": {
                  "const": 443
                },
                "explicit_port": {
                  "enum": [
                    null,
                    443
                  ]
                },
                "path": {
                  "type": "string"
                },
                "query": {
                  "type": "string"
                }
              },
              "required": [
                "literal",
                "scheme",
                "host",
                "port",
                "explicit_port",
                "path",
                "query"
              ],
              "additionalProperties": false
            },
            "headers": {
              "type": "array",
              "minItems": 3,
              "maxItems": 6,
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "prefixItems": [
                  {
                    "enum": [
                      "accept",
                      "accept-encoding",
                      "connection",
                      "host",
                      "user-agent",
                      "x-j1ai-request-id"
                    ]
                  },
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  }
                ],
                "items": false
              }
            },
            "request_id": {
              "type": "string",
              "pattern": "^syn-[A-Za-z0-9_-]{1,80}$"
            },
            "execution_id": {
              "type": "string",
              "pattern": "^syn-[A-Za-z0-9_-]{1,80}$"
            },
            "permit_id": {
              "type": "string",
              "pattern": "^syn-[A-Za-z0-9_-]{1,80}$"
            },
            "source_revision": {
              "type": "string",
              "pattern": "^syn-[A-Za-z0-9_-]{1,80}$"
            },
            "intended_user_agent": {
              "const": "J1AI-Research-Timing-Pilot/1.0"
            },
            "product_token": {
              "const": "Research-Timing-Pilot"
            },
            "header_configuration_hash": {
              "const": "14834db73d0b4448d1cb03dee3ca3399882e89bba546845d16175c4c5b164ae1"
            }
          },

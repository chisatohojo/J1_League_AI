            },
            "bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65536
            }
          },
          "required": [
            "request_id",
            "status",
            "content_type",
            "bytes"
          ],
          "additionalProperties": false
        },
        "readback_hash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "response_received_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "T.*(Z|[+]00:00)$"
        },
        "storage_verified_utc": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "T.*(Z|[+]00:00)$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "response_metadata",
        "readback_hash",
        "response_received_utc",
        "storage_verified_utc"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "evidence_level": {
            "const": "E0"
          }
        }

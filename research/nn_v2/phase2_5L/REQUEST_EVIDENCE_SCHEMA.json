            "schema_version",
            "method",
            "target_url",
            "URL",
            "headers",
            "request_id",
            "execution_id",
            "permit_id",
            "source_revision",
            "intended_user_agent",
            "product_token",
            "header_configuration_hash"
          ],
          "additionalProperties": false
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "canonical",
        "sha256"
      ],
      "additionalProperties": false
    },
    "adapter": {
      "type": "object",
      "properties": {
        "identity": {
          "type": "string",
          "pattern": "^syn-[A-Za-z0-9_-]{1,80}$"
        },
        "revision": {
          "type": "string",
          "pattern": "^syn-[A-Za-z0-9_-]{1,80}$"
        },
        "code_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "identity",
        "revision",
        "code_sha256"
      ],
      "additionalProperties": false
    },
    "E0": {
      "type": "object",
      "properties": {
        "configuration_revision": {
          "const": "NNV2_L_UA_CANDIDATE_V1"
        },
        "state": {
          "const": "CANDIDATE_FROZEN_NOT_ACTIVATED"
        }
      },
      "required": [
        "configuration_revision",
        "state"
      ],
      "additionalProperties": false
    },
    "E1": {
      "type": "object",
      "properties": {
        "prepared_request": {
          "$ref": "#/$defs/prepared"
        }
      },
      "required": [
        "prepared_request"
      ],
      "additionalProperties": false
    },
    "E2": {
      "type": "object",
      "properties": {
        "events": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "object",
            "properties": {
              "event": {
                "enum": [
                  "SEND_STARTED",
                  "SEND_COMPLETED",
                  "SEND_FAILED"
                ]
              },
              "timestamp_utc": {
                "type": "string",
                "format": "date-time",
                "pattern": "T.*(Z|[+]00:00)$"
              }
            },
            "required": [
              "event",
              "timestamp_utc"
            ],
            "additionalProperties": false
          }
        },
        "final_request": {
          "$ref": "#/$defs/prepared"
        }
      },
      "required": [
        "events",
        "final_request"
      ],
      "additionalProperties": false
    },
    "E3": {
      "type": "object",
      "properties": {
        "observation_method": {
          "const": "SYNTHETIC_INDEPENDENT_OBSERVER"
        },
        "observer_identity": {
          "type": "string",
          "pattern": "^syn-[A-Za-z0-9_-]{1,80}$"
        },
        "observed_request": {
          "$ref": "#/$defs/prepared"
        },
        "observed_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "T.*(Z|[+]00:00)$"
        },
        "observation_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "observation_method",
        "observer_identity",
        "observed_request",
        "observed_utc",
        "observation_hash"
      ],
      "additionalProperties": false

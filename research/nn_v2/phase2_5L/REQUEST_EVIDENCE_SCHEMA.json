    "E4": {
      "type": "object",
      "properties": {
        "response_metadata": {
          "type": "object",
          "properties": {
            "request_id": {
              "type": "string",
              "pattern": "^syn-[A-Za-z0-9_-]{1,80}$"
            },
            "status": {
              "type": "integer",
              "minimum": 100,
              "maximum": 599
            },
            "content_type": {
              "enum": [
                "text/plain",
                "text/html",
                "application/octet-stream"

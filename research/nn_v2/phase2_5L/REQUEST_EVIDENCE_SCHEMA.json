            "type": "null"
          },
          "readback_verified": {
            "type": "null"
          },
          "response_hash": {
            "type": "null"
          },
          "response_status": {
            "type": "null"
          },
          "storage_identity": {
            "type": "null"
          },
          "transport_adapter_identity": {
            "type": "null"
          },
          "transport_outcome": {

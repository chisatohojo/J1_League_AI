          "storage_identity": {
            "type": "null"
          },
          "prepared_request_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "transport_adapter_identity": {
            "$ref": "#/$defs/adapter"
          },
          "transport_outcome": {
            "enum": [
              "STARTED",
              "COMPLETED",
              "FAILED",
              "UNKNOWN"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence_level": {
            "const": "E3"
          }
        }
      },
      "then": {
        "properties": {
          "evidence_payload": {
            "$ref": "#/$defs/E3"
          },
          "failure_reason": {
            "type": "null"
          },
          "readback_verified": {
            "type": "null"
          },
          "response_hash": {
            "type": "null"
          },
          "response_status": {
            "type": "null"
          },
          "storage_identity": {
            "type": "null"
          },
          "transport_outcome": {
            "type": "null"
          },

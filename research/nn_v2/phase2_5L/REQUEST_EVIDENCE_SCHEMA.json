          "response_status": {
            "type": "null"
          },
          "storage_identity": {
            "type": "null"
          },
          "transport_adapter_identity": {
            "type": "null"
          },
          "transport_outcome": {
            "type": "null"
          },
          "prepared_request_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence_level": {

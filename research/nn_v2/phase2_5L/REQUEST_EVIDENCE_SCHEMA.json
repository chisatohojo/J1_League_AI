{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:j1ai:nn-v2:synthetic-ua-evidence:v1",
  "title": "NN v2 synthetic-only User-Agent evidence record v1",
  "description": "No live permit/transport authority. JSON identity, not wire bytes. Semantic hash/time/binding checks are mandatory in ua_evidence_contract.verify_record.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "NNV2_UA_EVIDENCE_V1"
    },
    "scope": {
      "const": "SYNTHETIC_ONLY"
    },
    "simulated": {
      "const": true
    },
    "retroactive": {
      "const": false
    },
    "run_started_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "T.*(Z|[+]00:00)$"
    },
    "request_id": {
      "type": "string",
      "pattern": "^syn-[A-Za-z0-9_-]{1,80}$"
    },
    "execution_id": {
      "type": "string",
      "pattern": "^syn-[A-Za-z0-9_-]{1,80}$"
    },
    "permit_id": {
      "type": "string",
      "pattern": "^syn-[A-Za-z0-9_-]{1,80}$"
    },
    "source_revision": {
      "type": "string",
      "pattern": "^syn-[A-Za-z0-9_-]{1,80}$"
    },
    "target_url": {
      "type": "string",
      "pattern": "^https://synthetic[.]invalid(?::443)?(/|$|[?])"
    },
    "method": {
      "const": "GET"
    },
    "intended_user_agent": {
      "const": "J1AI-Research-Timing-Pilot/1.0"
    },
    "product_token": {
      "const": "Research-Timing-Pilot"
    },
    "header_configuration_hash": {
      "const": "14834db73d0b4448d1cb03dee3ca3399882e89bba546845d16175c4c5b164ae1"
    },
    "prepared_request_hash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "transport_adapter_identity": {
      "anyOf": [
        {
          "$ref": "#/$defs/adapter"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_level": {
      "enum": [
        "E0",
        "E1",
        "E2",
        "E3",
        "E4"
      ]
    },
    "timestamp_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "T.*(Z|[+]00:00)$"
    },
    "timestamp_source": {
      "const": "SYNTHETIC_CLOCK"
    },
    "transport_outcome": {
      "enum": [
        null,
        "STARTED",
        "COMPLETED",
        "FAILED",
        "UNKNOWN"
      ]
    },
    "response_status": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        {
          "type": "null"
        }
      ]
    },
    "response_hash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "storage_identity": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "namespace": {
              "const": "SYNTHETIC_MEMORY"
            },
            "object_id": {
              "type": "string",
              "pattern": "^syn-[A-Za-z0-9_-]{1,80}$"
            }
          },
          "required": [
            "namespace",
            "object_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "readback_verified": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "failure_reason": {
      "enum": [
        null,
        "TRANSPORT_TIMEOUT",
        "TRANSPORT_ERROR",
        "CANCELLED",
        "HTTP_FAILURE",
        "STORAGE_READBACK_FAILED"
      ]
    },
    "evidence_payload": {
      "type": "object"
    },
    "record_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "scope",
    "simulated",
    "retroactive",
    "run_started_utc",
    "request_id",
    "execution_id",
    "permit_id",
    "source_revision",
    "target_url",
    "method",
    "intended_user_agent",
    "product_token",
